{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"url": "data/multi_region_dataset.csv"},
  "vconcat": [
    {
      "title": "Fires by Region",
      "transform": [
        {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["region"]}
      ],
      "mark": {"type": "arc", "innerRadius": 20, "stroke": "#fff"},
      "params": [{"name": "region_select", "select": {"type": "point", "fields": ["region"]}}],
      "encoding": {
        "theta": {"field": "count", "type": "quantitative", "stack": true},
        "color": {"field": "region", "type": "nominal"},
        "opacity": {
          "condition": {"param": "region_select", "value": 1},
          "value": 0.3
        }
      }
    },
    {
      "title": "Countries in Selected Region",
      "transform": [
        {"filter": {"param": "region_select"}},
        {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["country", "region"]}
      ],
      "mark": "bar",
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-x"},
        "x": {"field": "count", "type": "quantitative"},
        "color": {"field": "region", "type": "nominal"}
      }
    }
  ]
}
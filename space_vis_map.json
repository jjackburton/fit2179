{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/au_fires_space_100.csv"
  },
  "vconcat": [
    {
      "width": 800,
      "height": 400,
      "title": "Fires visible from space 2019",
      "projection": {"type": "mercator","scale": 700, "center": [134, -28]},
      "layer": [
        {
          "data": {
            "url": "data/STE_2016_AUST.json",
            "format": {
              "type": "topojson",
              "feature": "Aus_States"
            }
          },
          "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
        },
        {
          "transform": [{"filter": {"param": "time_brush"}}],
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "color": {
              "field": "brightness",
              "type": "quantitative",
              "title": "Brightness",
              "scale": {
                "type": "threshold",
                "domain": [320,504.4],
                "range": ["#fdbe85","#7f0000"]
              }
            },
            "tooltip": [
              {"field": "acq_time", "type": "temporal"},
              {"field": "brightness", "type": "quantitative"},
              {"field": "acq_date", "type": "temporal"}
            ]
          },
          "layer": [
            {"mark": {"type": "circle", "opacity": 0.4, "size": 15}},
            {
              "transform": [
                {
                  "window": [{"op": "rank", "as": "ranking"}],
                  "sort": [{"field": "brightness", "order": "descending"}]
                },
                {"filter": "datum.ranking == 1"},
                {
                  "calculate": "'The Brightest Visible Fire from the selected period was ' + datum['brightness']",
                  "as": "text_annotation_raw"
                },
                {
                  "calculate": "split(datum.text_annotation_raw, ';')",
                  "as": "text_annotation"
                }
              ],
              "mark": {
                "type": "text",
                "align": "right",
                "dx": -8,
                "dy": -8,
                "baseline": "middle",
                "fontStyle": "italic"
              },
              "encoding": {"text": {"field": "text_annotation"}}
            }
          ]
        }
      ]
    },
    {
      "width": 800,
      "height": 60,
      "mark": "line",
      "title": "Use this line chart to filter out the data based on time",
      "params": [
        {
          "name": "time_brush",
          "select": {"type": "interval", "encodings": ["x"]}
        }
      ],
      "encoding": {
        "x": {
          "field": "acq_date",
          "type":"temporal",
          "axis": {"title": "", "format": "%Y"}
        },
        "y": {
          "aggregate": "count",
          "axis": {"tickCount": 3, "grid": false},
          "title": "Count"
        }
      }
    },
    {
      "width": 800,
      "transform": [
        {
          "bin": {"step": 0.5, "extent": [5, 7]},
          "field": "brightness",
          "as": "Brightness"
        }
      ],
      "mark": "area",
      "encoding": {
        "x": {
          "field": "acq_date",
          "type": "temporal",
          "scale": {"domain": {"param": "time_brush"}},
          "axis": {"title": "", "tickCount": 5, "grid": false}
        },
        "y": {"aggregate": "count", "title": "Count of Fires"}
      }
    }
  ],
  "config": {"title": {"font": "sans-serif", "fontSize": 14}}
}
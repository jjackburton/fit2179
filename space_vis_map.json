{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/au_fires_space_100.csv"
  },
  "vconcat": [
    {
      "width": 800,
      "height": 400,
      "title": "Fires visible from space 2019",
        "projection": {
            "type": "equirectangular"},      
        "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/jjackburton/fit2179/refs/heads/main/STE_2016_AUST.json",
            "format": {
              "type": "topojson",
              "feature": "Aus_States"
            }
          },
          "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
        },
        {
          "transform": [{"filter": {"param": "time_brush"}}],
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "color": {
              "field": "brightness",
              "type": "quantitative",
              "title": "Brightness",
              "scale": {
                "type": "linear",
                "domain": [320,504.4],
                "range": ["#fdbe85","#7f0000"]
              }
            },
            "tooltip": [
              {"field": "brightness", "type": "quantitative"},
              {"field": "acq_date", "type": "temporal"}
            ]
          },
          "layer": [
            {"mark": {"type": "circle", "opacity": 0.4, "size": 15}}
          ]
        }
      ]
    },
    {
      "width": 800,
      "height": 60,
      "mark": "line",
      "title": "Use this line chart to filter out the data based on time",
      "params": [
        {
          "name": "time_brush",
          "select": {"type": "interval", "encodings": ["x"]}
        }
      ],
      "encoding": {
        "x": {
          "field": "acq_date",
          "type":"temporal",
          "scale": {"domain": ["2019-08-01", "2019-09-31"]},
          "axis": {"title": "", "format": "%b %d"}
        },
        "y": {
          "aggregate": "count",
          "axis": {"tickCount": 3, "grid": false},
          "title": "Count"
        }
      }
    }
  ],
  "config": {"title": {"font": "sans-serif", "fontSize": 14}}
}
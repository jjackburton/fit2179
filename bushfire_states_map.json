{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": "Total Bushfires by State per fire season - per 10000km2",
    "width": "container",
    "height": 500,
    
    "params": [
        {
            "name": "Season_selection",
            "value": 2021,
            "bind": {
                "input": "select",
                "options": [1617, 1718, 1819, 1920, 2021],
                "labels": ["2016-17", "2017-18", "2018-19", "2019-20", "2020-21"],
                "name": "Fire Season: "
                }
        }
    ],
    "projection": {
        "type": "equirectangular"
    },
    "layer": [
        {
            "data": {
                "url": "https://raw.githubusercontent.com/jjackburton/fit2179/refs/heads/main/data/STE_2016_AUST.json",
                "format": {
                    "type": "topojson",
                    "feature": "Aus_States"
                }
            },
            "transform": [
                {
                    "calculate": "'Data is not available in ' + datum.properties.STE_NAME16",
                    "as": "note"
                }
            ],
            "mark": {
                "type": "geoshape",
                "fill": "#ddd",
                "stroke": "white",
                "strokeWidth": 1
            },
            "encoding": {
                "tooltip": {
                    "field": "note"
                }
            }
        },
    {
        "data": {
            "url": "data/total_unplannedburns.csv",
            "format": {"type": "csv"}
            
        },
        "transform": [
            {
                "lookup": "State",
                "from": {
                    "data": {
                        "url": "https://raw.githubusercontent.com/jjackburton/fit2179/refs/heads/main/data/STE_2016_AUST.json",
                        "format": {
                        "type": "topojson",
                        "feature": "Aus_States"
                    }
                    },
                    "key": "properties.STE_NAME16"
                },
                "as": "geo"
            },
            {"filter": "datum.Season == Season_selection"},
            {"calculate": "(datum.Total_Burns / datum.Area) * 10000", "as": "Burns_per_10000km2"},
            {"calculate": "round(datum.Burns_per_10000km2 * 100) / 100", "as": "Burns_per_10000km2"}

        ],

        "mark": {
            "type": "geoshape",
            "stroke": "#fff",
            "strokeWidth": 0.5
        },
        "encoding": {
            "shape": {
                "field": "geo",
                "type": "geojson"
            },
            "color": {
                "field": "Burns_per_10000km2",
                "type": "quantitative",
                "title": "Total Burns",
                "scale": {
                    "scheme": "reds",
                    "domain": [0, 150]
                },
                "legend": {
                    "format": "d"
                }
            },
            "tooltip": [
                {"field": "State", "type": "nominal", "title": "State: "},
                {"field": "Burns_per_10000km2", "type": "quantitative", "title": "Total Burns: "}
                
            ]
        }
    }
    ],
"config": {}
}
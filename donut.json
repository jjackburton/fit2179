{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"url": "data/multi_region_dataset.csv"},
  
  "transform": [
    {
      "calculate": "replace(datum.region, /_/g, ' ')", 
      "as": "region"
    },
    {
      "calculate": "replace(datum.country, /_/g, ' ')", 
      "as": "country"
    }],
  "hconcat": [
    {
      "title": "NASA Regions",
      "width": 400, "height": 350,
      "transform": [
        {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["region"]},
            {"joinaggregate": [{"op": "sum", "field": "count", "as": "total"}]},
{"calculate": "format(datum.count / datum.total * 100, '.1f') + '%'", "as": "percentage"}
        
      ],
      "mark": {"type": "arc", "innerRadius": 20, "stroke": "#fff"},
      "params": [{"name": "region_select", "select": {"type": "point", "fields": ["region"]}}],
      "encoding": {
        "theta": {"field": "count", "type": "quantitative", "stack": true},
        "color": {"field": "region", "type": "nominal", "legend": {
    "orient": "bottom",
    "direction": "horizontal",
    "title": "Region"
  }, "scale": {
    "domain": ["Australia", "Mediterranean", "North America", "South America", "South Asia", "Southeast Asia", "Sub Saharan Africa"],
    "range": ["crimson", "#e6550d", "#31a354", "#756bb1", "#003f8a", "#fdae6b", "#888888"]}
},
        "opacity": {
          "condition": {"param": "region_select", "value": 1},
          "value": 0.3
        },
        "tooltip": [{"field": "percentage", "type": "nominal", "title": "Percentage: "},
      {"field": "region", "type": "nominal"}]
      }
    },
    {
      "title": "Countries in Selected Region",
      "width": 900, "height": 400,
      "transform": [
        {"filter": {"param": "region_select"}},
        {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["country", "region"]}
      ],
      "mark": "bar",
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-x"},
        "x": {"field": "count", "type": "quantitative", "scale": {"domain": [0, 1000]}},
        "tooltip": [{"field": "count", "type": "quantitative", "title":"Count: "}],
        "color": {"field": "region", "type": "nominal"}
      }
    }
  ]
}